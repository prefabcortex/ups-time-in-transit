<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.3/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" failOnAllIssues="true" cacheDirectory=".phpunit.cache">
  <php>
    <!-- The suite instantiates every model; a large API's need more than PHP's default 128M. -->
    <ini name="memory_limit" value="-1"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
  <testsuites>
    <testsuite name="prefabcortex/ups-time-in-transit test suite">
      <directory>./tests</directory>
    </testsuite>
  </testsuites>
</phpunit>
